# ---- Bazaar of Agents — x402 v2 on Base Sepolia (TESTNET ONLY) ----
# Copy to .env and fill in. .env is gitignored; NEVER commit real keys.
# YOU generate keys and fund wallets — never paste a private key into a tool (plan §3).

# One wallet per agent. Generate 4 throwaway hex keys (0x-prefixed). Testnet only.
ORCH_PRIVATE_KEY=0x
SEARCH_PRIVATE_KEY=0x
SEARCH_PAY_TO=0x
FETCH_PRIVATE_KEY=0x
FETCH_PAY_TO=0x
VERIFY_PRIVATE_KEY=0x
VERIFY_PAY_TO=0x

# Facilitator. We use the CDP v2 facilitator via @coinbase/x402's createFacilitatorConfig(),
# which supplies the api.cdp.coinbase.com URL + JWT auth from the CDP creds below. So for the
# CDP path FACILITATOR_URL is OPTIONAL. Set it only to point at a no-auth/self-hosted v2
# facilitator instead (no CDP creds needed in that case).
# FACILITATOR_URL=https://your-no-auth-v2-facilitator

# CDP API credentials — required for the CDP facilitator. Get them from the CDP portal.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Where agents POST their events so the dashboard can see them (plan §0.2).
ORCH_INGEST_URL=http://localhost:4000/ingest

# CAIP-2 network id. Base Sepolia = eip155:84532 (NOT the v1 string "base-sepolia").
NETWORK=eip155:84532

# Optional JSON-RPC for on-chain reads (batch-settlement stretch / gas-sponsoring extensions only;
# the plain `exact` scheme does not require it).
EVM_RPC_URL=https://sepolia.base.org
